{
  "manifest_version": 3,
  "name": "Moribito",
  "version": "0.1.0",
  "description": "URLだけでフィッシングサイトを判定します。ホモグリフ・混在スクリプト・ブランド詐称サブドメインをローカルで検出し、閲覧履歴を外部に送信しません。",
  "default_locale": "ja",
  "minimum_chrome_version": "116",
  "permissions": [
    "webNavigation",
    "storage",
    "offscreen",
    "scripting",
    "alarms"
  ],
  "host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  },
  "action": {
    "default_title": "Moribito",
    "default_popup": "src/ui/popup.html",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "options_ui": {
    "page": "src/ui/options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'none'"
  }
}
